# Non-secret defaults match the owner-only signup sheet and the canonical guide.
# Leave every secret empty in this file. Set secrets only in the host secret store.
# Do not commit a filled .env. Do not paste secrets into GitHub.

HOST=0.0.0.0
PORT=8080
# Leave false unless the immediate peer is a proxy you operate.
# If true, TRUSTED_PROXY_CIDRS is required or the process refuses to start.
# The client address is the first X-Forwarded-For entry from the right that is not itself in this list.
TRUST_PROXY=false
TRUSTED_PROXY_CIDRS=
GLOBAL_SIGNUP_PER_HOUR=30
GLOBAL_DOWNLOAD_PER_HOUR=60
GOOGLE_TIMEOUT_MS=8000

# Browser origin of the GitHub Pages site (no path). The repo is served under /genlaunch-landing/.
ALLOWED_ORIGINS=https://navarretteroger.github.io

# Same existing Google account for Sheets and Drive: navarretteroger@gmail.com
# Desktop OAuth client created under that account. Not a service account.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Non-secret. Parent-confirmed owner-only sheet. Override only if the sheet is replaced.
GOOGLE_SHEET_ID=1RXBQl4KQU-FUOLBmL6iXjy3mcaIzw8Xl5n5vVtcbRVw
GOOGLE_SHEET_TAB=Customer Recovery — Landing Page Signups
GOOGLE_SHEET_GID=389366344

# Non-secret server target. Canonical ~10-page guide. Not a public URL.
DRIVE_FILE_ID=1508Lh4WrwEcHKeFOx0RFm_cOSwbiHEgh

# Generate on the host: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Store the value as a secret. Do not commit it.
GRANT_SIGNING_SECRET=
GRANT_TTL_SECONDS=900

PRIVACY_NOTICE_VERSION=2026-11-06
SOURCE_LABEL=genlaunch-landing

# Optional. Publish a support address on the page only after it is verified.
# Leave empty. The page does not invent one.
SUPPORT_CONTACT=

# file (default) keeps idempotency records on local disk. memory loses them on restart.
IDEMPOTENCY_STORE=file
# IDEMPOTENCY_PATH=

RATE_LIMIT_SIGNUP_PER_MINUTE=8
RATE_LIMIT_DOWNLOAD_PER_MINUTE=20

# Ignored if set. This server does not use service-account credentials.
# GOOGLE_APPLICATION_CREDENTIALS=
